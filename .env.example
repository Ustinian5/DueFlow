LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
DATABASE_PATH=dueflow.db
INBOX_PATH=inbox
EXPORT_PATH=exports
# Optional. Used for image/screenshot OCR on non-macOS systems or when overriding macOS Vision.
# Example: DUEFLOW_OCR_COMMAND=tesseract {path} stdout -l chi_sim+eng
DUEFLOW_OCR_COMMAND=
# Optional desktop intake limits. Defaults: 200000 text characters and 25 MiB per uploaded file.
DUEFLOW_MAX_TEXT_CHARS=200000
DUEFLOW_MAX_UPLOAD_MB=25
